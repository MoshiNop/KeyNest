# Do NOT commit plaintext keystore passwords to disk when avoidable.
# Prefer environment variables during release builds:
#   ANDROID_KEYSTORE_PATH=/path/to/release.jks
#   ANDROID_KEYSTORE_PASSWORD=...
#   ANDROID_KEY_ALIAS=keynest
#   ANDROID_KEY_PASSWORD=...
storeFile=release.jks
keyAlias=keynest
