# KeyNest Android Release Signing Configuration Template
# Copy this file to 'key.properties' in this directory ('android/key.properties')
# and populate your release keystore parameters.
#
# DO NOT commit 'key.properties' or keystore files to version control!
#
# Note for Windows paths:
#   Use forward slashes (e.g. C:/Users/Moshiur/keystores/keynest-release.jks)
#   or escaped backslashes (e.g. C:\\Users\\Moshiur\\keystores\\keynest-release.jks).

storeFile=C:/Users/Moshiur/keystores/keynest-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=keynest
keyPassword=YOUR_KEY_PASSWORD
